{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aieo.ee/schemas/rules-history.schema.json",
  "title": "Every rule id @aieo/rules has shipped",
  "description": "A rule id is never reused. A removed rule stays here with `retired`; `since` is the spec version that introduced it; `changed` lists the versions in which the rule started reporting cases it did not report before.",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "since"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "retired": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "replaced_by": {
            "type": "string"
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "description": "Spec versions that widened the rule (new findings on unchanged sites)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
